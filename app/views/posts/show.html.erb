<div class="container mt-5">
  <div class="mb-3">
    <%= link_to '← 一覧に戻る', posts_path, class: 'text-primary text-decoration-none' %>
  </div>

  <h2 class="mb-4">予定</h2>

  <table class="table table-bordered w-50">
    <tr>
      <th class="table-light">開始日</th>
      <td><%= @post.start_date.strftime('%Y/%m/%d') %></td>
    </tr>
    <tr>
      <th class="table-light">終了日</th>
      <td><%= @post.end_date.strftime('%Y/%m/%d') %></td>
    </tr>
    <tr>
      <th class="table-light">終日</th>
      <td><%= @post.all_day? ? '○' : '' %></td>
    </tr>
    <tr>
      <th class="table-light">スケジュールメモ</th>
      <td><%= @post.memo.presence || '（なし）' %></td>
    </tr>
  </table>

  <div class="mt-3">
    <%= link_to '編集', edit_post_path(@post), class: 'btn btn-outline-primary' %>
  </div>
</div>
